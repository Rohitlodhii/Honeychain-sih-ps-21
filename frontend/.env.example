# Frontend Environment Configuration
# Browser uses same-origin /api/backend proxy; public URL not needed.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only: EC2 FastAPI base URL used by app/api/backend/[...path]/route.ts
# Set this on Vercel/hosting to your EC2 http URL, e.g. http://3.109.3.187:8001
BACKEND_URL=http://3.109.3.187:8001
