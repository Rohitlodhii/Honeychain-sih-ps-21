{
  "expo": {
    "name": "HoneyChain Mobile",
    "slug": "honeychain-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "honeychain",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "barStyle": "light-content",
      "translucent": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.honeychain.mobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "apiUrl": "http://3.109.3.187:8001"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/logo.png",
          "dark": {
            "image": "./assets/logo.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HoneyChain to use your location to save your apiary location."
        }
      ],
      "expo-localization",
      "expo-router",
      "expo-sharing"
    ]
  }
}
