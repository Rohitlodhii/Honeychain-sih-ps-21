# Backend Environment Configuration
# Copy this to .env and fill in production values

# Database
DATABASE_URL=sqlite:///./honey.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/honeychain

# Set APP_ENV=production in hosted environments. Production refuses to start
# without SECRET_KEY and FRONTEND_URL.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-development-secret

# Required to create cooperative-admin accounts. Distribute out of band.
ADMIN_INVITE_CODE=replace-with-a-private-admin-invite

# Required in APP_ENV=production for /api/sms/webhook signature validation.
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WEBHOOK_URL=https://your-api-domain.example/api/sms/webhook

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Frontend URL (for QR code verification links)
FRONTEND_URL=http://localhost:3000

# API Port
API_PORT=8000
